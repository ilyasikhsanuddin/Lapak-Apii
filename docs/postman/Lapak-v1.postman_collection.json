{
    "variable": [
        {
            "key": "base_url",
            "type": "default",
            "value": "http://127.0.0.1:8000"
        },
        {
            "key": "kunci_sesi",
            "type": "secret",
            "value": ""
        },
        {
            "key": "pengenal_sesi",
            "type": "default",
            "value": ""
        },
        {
            "key": "kunci_admin",
            "type": "secret",
            "value": ""
        },
        {
            "key": "kunci_keuangan",
            "type": "secret",
            "value": ""
        },
        {
            "key": "kunci_auditor",
            "type": "secret",
            "value": ""
        },
        {
            "key": "kunci_sri",
            "type": "secret",
            "value": ""
        },
        {
            "key": "kunci_tini",
            "type": "secret",
            "value": ""
        },
        {
            "key": "kunci_andi",
            "type": "secret",
            "value": ""
        }
    ],
    "info": {
        "name": "Lapak-v1 API Collection",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Autentikasi dan Sesi",
            "item": [
                {
                    "request": {
                        "body": {
                            "raw": "{\"surel\":\"sri@lapak.test\",\"kata_sandi\":\"LapakContoh#2026\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            },
                            "mode": "raw"
                        },
                        "method": "POST",
                        "url": "{{base_url}}/api/v1/masuk",
                        "header": [
                            {
                                "key": "Content-Type",
                                "type": "text",
                                "value": "application/json"
                            }
                        ]
                    },
                    "name": "POST /api/v1/masuk",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const res = pm.response.json();",
                                    "if (pm.response.code === 200 && res.data && res.data.kunci) {",
                                    "    pm.collectionVariables.set(\"kunci_sesi\", res.data.kunci);",
                                    "    if (res.data.sesi && res.data.sesi.pengenal) {",
                                    "        pm.collectionVariables.set(\"pengenal_sesi\", res.data.sesi.pengenal);",
                                    "    }",
                                    "    const surel = (res.data.pengguna && res.data.pengguna.surel) || \"\";",
                                    "    const akun = surel.split(\"@\")[0];",
                                    "    if (akun) {",
                                    "        pm.collectionVariables.set(\"kunci_\" + akun, res.data.kunci);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "GET /api/v1/saya",
                    "request": {
                        "method": "GET",
                        "url": "{{base_url}}/api/v1/saya",
                        "header": [
                            {
                                "key": "Authorization",
                                "type": "text",
                                "value": "Bearer {{kunci_sesi}}"
                            }
                        ],
                        "auth": {
                            "bearer": [
                                {
                                    "key": "token",
                                    "type": "string",
                                    "value": "{{kunci_sesi}}"
                                }
                            ],
                            "type": "bearer"
                        }
                    }
                },
                {
                    "name": "POST /api/v1/keluar",
                    "request": {
                        "method": "POST",
                        "url": "{{base_url}}/api/v1/keluar",
                        "header": [
                            {
                                "key": "Authorization",
                                "type": "text",
                                "value": "Bearer {{kunci_sesi}}"
                            }
                        ],
                        "auth": {
                            "bearer": [
                                {
                                    "key": "token",
                                    "type": "string",
                                    "value": "{{kunci_sesi}}"
                                }
                            ],
                            "type": "bearer"
                        }
                    }
                },
                {
                    "name": "GET /api/v1/sesi",
                    "request": {
                        "method": "GET",
                        "url": "{{base_url}}/api/v1/sesi",
                        "header": [
                            {
                                "key": "Authorization",
                                "type": "text",
                                "value": "Bearer {{kunci_sesi}}"
                            }
                        ],
                        "auth": {
                            "bearer": [
                                {
                                    "key": "token",
                                    "type": "string",
                                    "value": "{{kunci_sesi}}"
                                }
                            ],
                            "type": "bearer"
                        }
                    }
                },
                {
                    "name": "POST /api/v1/sesi/konfirmasi",
                    "request": {
                        "method": "POST",
                        "url": "{{base_url}}/api/v1/sesi/konfirmasi",
                        "header": [
                            {
                                "key": "Authorization",
                                "type": "text",
                                "value": "Bearer {{kunci_sesi}}"
                            }
                        ],
                        "auth": {
                            "bearer": [
                                {
                                    "key": "token",
                                    "type": "string",
                                    "value": "{{kunci_sesi}}"
                                }
                            ],
                            "type": "bearer"
                        }
                    }
                },
                {
                    "name": "DELETE /api/v1/sesi/:pengenal",
                    "request": {
                        "method": "DELETE",
                        "url": "{{base_url}}/api/v1/sesi/{{pengenal_sesi}}",
                        "header": [
                            {
                                "key": "Authorization",
                                "type": "text",
                                "value": "Bearer {{kunci_sesi}}"
                            }
                        ],
                        "auth": {
                            "bearer": [
                                {
                                    "key": "token",
                                    "type": "string",
                                    "value": "{{kunci_sesi}}"
                                }
                            ],
                            "type": "bearer"
                        }
                    }
                }
            ]
        },
        {
            "name": "Katalog dan Toko",
            "item": [
                {
                    "name": "GET /api/v1/kategori",
                    "request": {
                        "method": "GET",
                        "url": "{{base_url}}/api/v1/kategori",
                        "header": []
                    }
                },
                {
                    "name": "GET /api/v1/produk",
                    "request": {
                        "method": "GET",
                        "url": "{{base_url}}/api/v1/produk",
                        "header": []
                    }
                },
                {
                    "name": "GET /api/v1/toko/:slug",
                    "request": {
                        "method": "GET",
                        "url": "{{base_url}}/api/v1/toko/batik-laweyan-bu-sri",
                        "header": []
                    }
                }
            ]
        }
    ]
}
