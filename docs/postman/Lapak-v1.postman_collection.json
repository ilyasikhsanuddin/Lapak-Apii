                                      "name":  "POST /api/v1/masuk",
                                      "event":  [
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "const hasil = pm.response.json();",
                                                                                    "const kunci = hasil?.data?.kunci;",
                                                                                    "if (pm.response.code === 201 \u0026\u0026 kunci) {",
                                                                                    "    pm.collectionVariables.set(\u0027kunci_sesi\u0027, kunci);",
                                                                                    "    console.log(\u0027Kunci sesi berhasil disimpan.\u0027);",
                                                                                    "} else {",
                                                                                    "    console.error(\u0027Kunci sesi tidak ditemukan. Periksa respons login.\u0027);",
                                                                                    "}"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "test"
                                                    }
                                                ]
